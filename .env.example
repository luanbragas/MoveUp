# Copie para .env (nunca commitar o .env). Valores apenas para desenvolvimento local.
POSTGRES_SUPERUSER_PASSWORD=local-only-superuser
DB_OWNER_PASSWORD=local-only-owner
DB_API_PASSWORD=local-only-api
DB_WORKER_PASSWORD=local-only-worker
DB_REPORT_PASSWORD=local-only-report
S3_ACCESS_KEY=moveup-local
S3_SECRET_KEY=local-only-s3-secret
# Firebase Auth: id do projeto (não é segredo). Valida aud/iss do token.
FIREBASE_PROJECT_ID=moveup-9b809
# Criptografia de campo (local): gere com node backend/scripts/generate-local-kek.mjs e cole aqui.
MOVEUP_LOCAL_KEK=
